rules_version = '2';

// PRODUCTION RULES for cworldgroup-cca68 (3C portal + 3C Doors).
// Merged by `node scripts/merge-prod-rules.ts` (3c-knock-logic), then HAND-EDITED here:
// 2026-10-24 Chompen store gate (`config/app`) and campaign soft delete (archive);
// 2026-10-26 archive made one-way (a client can no longer un-archive by editing or
// deleting archived/archivedAt/archivedBy). These hand edits are NOT yet in the merge
// source: carry them back into scripts/merge-prod-rules.ts (3c-knock-logic) before the
// next regenerate, or they will be lost. Deploy state: see docs/security/firestore-rules-deploy.md.
//   1. Portal: the portal repo's origin/master rules (docs/prod/portal-master.rules) unchanged, plus
//      the portal's server-only saleDrafts block.
//   2. 3C Doors: every block of the app's firestore.rules (users read/update, campaigns, houses,
//      knocks); signedIn() also refuses users with status 'inactive' and unapproved self-signups.
// Firestore allows a request when ANY matching allow does, so the app's users allows add to the
// portal's (its `allow update, delete: if false` cancels nothing). The Admin SDK (portal APIs,
// the lead import) bypasses all of this.
service cloud.firestore {
  match /databases/{database}/documents {
    // Chompen store update gate: the app reads config/app before sign-in too.
    // Public read of that one doc, no listing, no client writes (set it in the
    // console or with the Admin SDK). config/fiberRepMap stays denied here.
    match /config/{docId} {
      allow get: if docId == 'app';
      allow list, create, update, delete: if false;
    }

    // ======================== 3C portal (portal master rules) ========================
    // Is the signed-in caller back-office (owner/admin/operations)? Field
    // managers are deliberately excluded: the onboarding APIs never show them
    // other hires' checklists either.
    function isPlatformManagement() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data.get('role', null)
        in ['admin', 'operations', 'owner'];
    }

    // The owner role only (the finance tier, above admin).
    function isOwnerRole() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data.get('role', null) == 'owner';
    }

    // Is the signed-in caller an APPROVED (active) user? Self-signups are
    // status 'pending' and fail this until an admin flips them to 'active'
    // (Admin SDK / Console, which bypass rules).
    function isApproved() {
      return request.auth != null &&
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.status == 'active';
    }

    // A hire who has been invited and holds a field role, but has not finished
    // onboarding. Deliberately narrower than isApproved(): an unapproved
    // self-signup has no fieldRole and a decommissioned account is 'inactive',
    // so neither matches. Used ONLY for chat — the client chose to let a new
    // hire talk to their team from day one.
    function isOnboardingMember() {
      return request.auth != null &&
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.status == 'pending' &&
        // Keep this list in step with ONBOARDING_FIELD_ROLES in src/types/auth.ts;
        // the rules language cannot import TypeScript constants. It KEEPS the
        // retired legacy/IBO tiers — a hire already mid-checklist on one of them
        // must not lose chat when the invite form stops offering it.
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.get('fieldRole', null) in
          ['entry_level_rep', 'entry_rep', 'l1_manager', 'l2_manager',
           'ibo_level_1', 'ibo_level_2', 'ibo_level_3', 'ibo_level_4',
           'ae_tier_1', 'ae_tier_2', 'regional_manager', 'director'];
    }

    // A user may create ONLY their own profile, ONLY pending, ONLY these 4
    // fields. No client update/delete — approval + edits go through the Admin
    // SDK. Self-read is allowed at any status so the pending screen can load.
    // displayName is validated ONLY when present: during the deploy window a
    // client still running the OLD signup code sends just 3 fields (no
    // displayName), and that write must keep passing so it isn't rolled back
    // (signUp() deletes the just-created auth user if the profile write fails).
    // The email must be the account's own sign-in address, so a signup cannot
    // point admins and portal mail at someone else's inbox.
    // Only a password signup (the team-code form) creates a profile: Sign in
    // with Apple / Google never starts an account (AuthContext rejects a
    // social sign-in with no profile and /api/portal/auth/unlinked-social
    // deletes the Auth user it made).
    match /users/{userId} {
      allow read: if request.auth != null && request.auth.uid == userId;
      allow create: if request.auth != null && request.auth.uid == userId
        && request.auth.token.firebase.sign_in_provider == 'password'
        && request.resource.data.status == 'pending'
        && request.resource.data.keys().hasOnly(['email', 'displayName', 'status', 'createdAt'])
        && request.resource.data.email is string
        && request.auth.token.email is string
        && request.resource.data.email.lower() == request.auth.token.email.lower()
        && (!('displayName' in request.resource.data) ||
            (request.resource.data.displayName is string &&
             request.resource.data.displayName.size() > 0 &&
             request.resource.data.displayName.size() <= 100));
      allow update, delete: if false;
    }

    // Back-office users can read all users.
    match /users/{userId} {
      allow read: if request.auth != null &&
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role in ['admin', 'operations', 'owner'];
    }

    // Per-user chat read receipts (client-written). Chat members only.
    // lastReadAt must be the server's clock (the client writes serverTimestamp()):
    // these receipts drive the "Read by" sheet, so a hand-picked (e.g. future)
    // time would claim reads of messages never seen. No client delete — none is
    // needed, and the old write rule already denied it (no request.resource).
    match /users/{userId}/chatReads/{channelId} {
      allow read: if (isApproved() || isOnboardingMember()) && request.auth.uid == userId;
      allow create, update: if (isApproved() || isOnboardingMember()) && request.auth.uid == userId &&
        request.resource.data.keys().hasOnly(['lastReadAt']) &&
        request.resource.data.lastReadAt == request.time;
    }

    // Per-user chat blocks (App Store guideline 1.2). Server-only: the chat API
    // reads and writes them with the Admin SDK, so no client access at all.
    // Explicit for clarity; the default deny below already covers it.
    match /users/{userId}/chatBlocks/{blockedId} {
      allow read, write: if false;
    }

    // Server-only per-user secrets, e.g. users/{uid}/private/appleAuth (the
    // Sign in with Apple refresh token, revoked on account deletion). Admin SDK
    // only. Explicit for clarity; the default deny below already covers it.
    match /users/{userId}/private/{docId} {
      allow read, write: if false;
    }

    // Per-user "I've been paid for this sale" marks (client-written). Private to
    // the rep: their own reconciliation against a paycheck, never a payroll
    // record, so nobody — manager, admin or owner — can read another user's.
    match /users/{userId}/salePaid/{saleId} {
      allow read: if isApproved() && request.auth.uid == userId;
      allow create, update: if isApproved() && request.auth.uid == userId &&
        request.resource.data.keys().hasOnly(['paidAt']) &&
        request.resource.data.paidAt is timestamp;
      allow delete: if isApproved() && request.auth.uid == userId;
    }

    // Sales are created, updated and deleted exclusively server-side
    // (/api/portal/sales, /api/portal/sales/[id], /api/portal/sales/approve) so
    // that totalPoints is calculated by the server and cannot be chosen by the
    // submitter. Previously `isApproved()` on every operation, which let any
    // approved rep addDoc a sale with totalPoints: 99999 — or deleteDoc a
    // colleague's sale — straight from the browser console.
    // No client-SDK code path reads or writes this collection: the portal
    // sales list, dashboard stats and pipeline all fetch() API routes.
    match /sales/{saleId} {
      allow read, write: if false;
    }

    // Sale drafts from 3C Doors (one per Sold tapped at a door). Server-only:
    // created, listed and closed through /api/portal/sales/drafts and
    // /api/portal/sales with the Admin SDK, which stamps the rep from the token.
    match /saleDrafts/{draftId} {
      allow read, write: if false;
    }

    // Notifications are created/updated exclusively server-side (Admin SDK via
    // /api/portal/notifications and lib/notifications). Clients may only read
    // their own — at ANY status, so mid-onboarding (pending) reps see their bell.
    match /notifications/{notifId} {
      allow read: if request.auth != null && resource.data.userId == request.auth.uid;
      allow write: if false;
    }

    // Admin-managed content, served through /api/portal/training. Previously
    // any approved rep could delete every training resource from the console.
    match /training/{docId} {
      allow read, write: if false;
    }

    // Written server-side only (/api/portal/training/progress). Auto-ID'd docs
    // carry userId as a FIELD, not in the path, so a per-user client rule in
    // the style of chatReads is not expressible here — the strongest possible
    // would be request.resource.data.userId == request.auth.uid, which would
    // not stop a rep marking every module complete. Server-only is correct.
    match /userProgress/{docId} {
      allow read, write: if false;
    }

    // Unused collection. Standings are computed from `sales` in
    // /api/portal/leaderboard — nothing in the repo reads or writes this.
    match /leaderboard/{docId} {
      allow read, write: if false;
    }

    // Tax and banking items (W-9, direct deposit; OWNER_ONLY_ONBOARDING_ITEM_IDS
    // in src/types/onboarding.ts) are the person's own or an owner's to read;
    // admins and operations read every other item.
    match /userOnboarding/{docId} {
      allow read: if isApproved() &&
        (resource.data.userId == request.auth.uid
          || isOwnerRole()
          || (isPlatformManagement()
            && !(resource.data.get('itemId', '') in ['w9', 'direct_deposit'])));
      allow write: if false;
    }

    match /userChannelOnboarding/{docId} {
      allow read: if isApproved() &&
        (resource.data.userId == request.auth.uid || isPlatformManagement());
      allow write: if false;
    }

    match /onboardingInvites/{docId} {
      allow read, write: if false;
    }
    match /candidateOnboarding/{docId} {
      allow read, write: if false;
    }
    match /userSensitive/{uid} {
      allow read, write: if false;
    }
    match /adminAuditLog/{logId} {
      allow read, write: if false;
    }
    match /sensitiveAccessLog/{logId} {
      allow read, write: if false;
    }
    match /adminImports/{importId} {
      allow read, write: if false;
    }
    match /fiberReports/{id} {
      allow read, write: if false;
    }
    // Solar: admin-SDK routes only (/api/portal/solar/*), same as fiberReports.
    match /solarLeads/{id} {
      allow read, write: if false;
    }
    match /solarBookings/{id} {
      allow read, write: if false;
    }
    match /solarAvailability/{id} {
      allow read, write: if false;
    }
    // Google Calendar connections: encrypted refresh tokens and single-use
    // OAuth states. Server only (lib/solar/google/connection.ts), never a client.
    match /solarGoogleTokens/{uid} {
      allow read, write: if false;
    }
    match /solarGoogleOAuthStates/{nonce} {
      allow read, write: if false;
    }
    match /expediteOrders/{id} {
      allow read, write: if false;
    }
    match /payrollDisputes/{id} {
      allow read, write: if false;
    }
    match /leadsRequests/{id} {
      allow read, write: if false;
    }
    match /formOptions/{key} {
      allow read, write: if false;
    }
    match /managerInterviews/{id} {
      allow read, write: if false;
    }
    match /bugReports/{id} {
      allow read, write: if false;
    }
    match /formAlerts/{key} {
      allow read, write: if false;
    }
    match /alertTasks/{taskId} {
      allow read, write: if false;
    }
    match /onboardingNudges/{uid} {
      allow read, write: if false;
    }
    // Owner push announcements: server-only (Admin SDK via the owner API and cron).
    match /announcements/{announcementId} {
      allow read, write: if false;
    }
    // Ask 3C: the owner's knowledge notes (restricted carrier material), the
    // exchange log, the current and finished Practice sessions and the
    // per-rep daily counters. Server-only (Admin SDK via /api/portal/ask[/practice] and the
    // owner's /api/portal/knowledge routes).
    match /knowledgeNotes/{noteId} {
      allow read, write: if false;
    }
    match /askLog/{logId} {
      allow read, write: if false;
    }
    match /practiceLog/{logId} {
      allow read, write: if false;
    }
    match /practiceSessions/{uid} {
      allow read, write: if false;
    }
    match /practiceAssignments/{assignmentId} {
      allow read, write: if false;
    }
    match /practiceCorrections/{correctionId} {
      allow read, write: if false;
    }
    match /askUsage/{usageId} {
      allow read, write: if false;
    }

    // Chat message reports (App Store guideline 1.2). Server-only: filed by
    // POST /api/portal/chat/messages/report, worked in the admin queue through
    // /api/portal/admin/chat-reports. Explicit; the default deny covers it too.
    match /chatReports/{reportId} {
      allow read, write: if false;
    }

    // Evidence copies to retry (lib/chat/evidence, /api/cron/chat-evidence).
    // Server-only; explicit, the default deny covers it too.
    match /chatEvidencePending/{pendingId} {
      allow read, write: if false;
    }

    match /chatChannels/{channelId} {
      allow read: if (isApproved() || isOnboardingMember()) && request.auth.uid in resource.data.memberIds;
      allow write: if false;
    }

    match /chatChannels/{channelId}/messages/{messageId} {
      allow read: if (isApproved() || isOnboardingMember()) &&
        request.auth.uid in get(/databases/$(database)/documents/chatChannels/$(channelId)).data.memberIds;
      allow write: if false;
    }

    match /chatChannels/{channelId}/messages/{messageId}/reactions/{reactionId} {
      allow read: if (isApproved() || isOnboardingMember()) &&
        request.auth.uid in get(/databases/$(database)/documents/chatChannels/$(channelId)).data.memberIds;
      allow write: if false;
    }

    // ======================== 3C Doors (app rules) ========================
    // 3C Knock data rules — PROPOSAL, local emulator only until Jacob approves.
    //
    // Who is who: the portal's users/{uid} doc. role 'owner' or 'admin' = owner (sees and edits
    // everything). A manager is whoever reps point at with users/{rep}.managerId: they see and
    // lasso their team's houses (houses.managerId = them) and read their team's knocks
    // (knocks.managerId = them). Everyone else is a rep: they see only the houses assigned to them
    // and only their own knocks. Shapes are in src/lib/types.ts.
    //
    // Queries these rules are written to allow:
    //   rep:     houses where campaignId == X and assignedRepId == myUid
    //   anyone:  houses where campaignId in [their other turned-on campaigns] and assignedRepId == myUid
    //   manager: houses where campaignId == X and managerId == myUid (plus the rep query for their own)
    //   owner:   houses where campaignId == X
    //   rep/manager: houses where campaignId == X and assignedRepId == null (X open and turned on for them)
    //   rep:     knocks  where repId == myUid and createdAt >= T
    //   owner:   knocks  where houseId == X (a door's full history)
    //   owner:   knocks  where campaignId == X and createdAt >= T (team activity, paged)
    //   manager: knocks  where managerId == myUid and campaignId == X and createdAt >= T (their team's)
    //   anyone:  campaigns (all; pickers)
    //   owner:   users (all; manager legend names)
    //   manager: users where managerId == myUid (their team, for the legend)

    // Signed in with access: an active user, or a hire still onboarding ('pending' with an onboarding
    // field role, like the portal's isOnboardingMember, or the solar starter role entry_canvasser:
    // they may knock while onboarding). A user the
    // portal switched off ('inactive', #38) and a self-signup the portal hasn't approved ('pending'
    // with no field role, M28 bug hunt 2026-10-18) get nothing. No status (older docs, test
    // fixtures) counts as active.
    function signedIn() {
      return request.auth != null && hasAccess(me());
    }

    // A campaign selling solar: its doors' Sold comes only from the portal (SOLAR_PORTAL_HANDOFF.md).
    function solarCampaign(campaignId) {
      // exists() first: a get() of a deleted campaign errors, which would refuse any Sold on its doors.
      return campaignId is string && campaignId != ''
        && exists(/databases/$(database)/documents/campaigns/$(campaignId))
        && get(/databases/$(database)/documents/campaigns/$(campaignId)).data.get('type', '') == 'solar';
    }

    // Keep the roles in step with the portal's isOnboardingMember (ONBOARDING_FIELD_ROLES in the
    // portal's src/types/auth.ts) and the app's copy (ONBOARDING_FIELD_ROLES in src/lib/roles.ts,
    // which src/lib/roles.test.ts checks against this list).
    function hasAccess(u) {
      let status = u.get('status', 'active');
      return status == 'active'
        || (status == 'pending'
          && (u.get('fieldRole', null) in ['entry_level_rep', 'entry_rep', 'l1_manager', 'l2_manager',
                                           'ibo_level_1', 'ibo_level_2', 'ibo_level_3', 'ibo_level_4',
                                           'ae_tier_1', 'ae_tier_2', 'regional_manager', 'director']
            // A solar starter (ONBOARDING_SOLAR_ROLES in src/lib/roles.ts), with or without a fiber role.
            || u.get('solarRole', null) in ['entry_canvasser']));
    }

    // The signed-in user's profile.
    function me() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }

    function isOwner() {
      return signedIn() && me().get('role', '') in ['owner', 'admin'];
    }

    // An open campaign's unassigned door (LOGIC_REQUESTS #27, OPEN_CAMPAIGNS_SPEC.md): `house`
    // (a houses doc's data) has no rep, and its campaign has access 'open' and is turned on for the
    // signed-in user. They may see it and knock it; the knock makes the door theirs.
    // `house.assignedRepId`, not `.get('assignedRepId', null)`: on a query without an assignedRepId
    // filter the rules take get()'s default as proven, letting a rep list other reps' doors.
    function openToMe(house) {
      return signedIn()
        && house.assignedRepId == null
        && house.campaignId in me().get('campaignIds', [])
        && get(/databases/$(database)/documents/campaigns/$(house.campaignId)).data.get('access', 'locked') == 'open';
    }

    // The manager of user `uid` (null if none).
    function managerOf(uid) {
      return get(/databases/$(database)/documents/users/$(uid)).data.get('managerId', null);
    }

    // Keys this write changes compared with the stored doc.
    function changedKeys() {
      return request.resource.data.diff(resource.data).affectedKeys();
    }

    // Profiles come from the portal (which writes campaignIds / activeCampaignId with the admin
    // SDK; these rules cover only app-side writes). In the app:
    //   - anyone switches their own active campaign, only to one turned on for them (or none);
    //   - managers turn campaigns on/off and pick the active one for their own team;
    //   - owners do that for anyone, and also pick ring colours;
    //   - owners turn far-knock blocking off for another account (`farBlockExempt`, the App Review
    //     demo login, LOGIC_REQUESTS #29); never on themselves. Nobody sets it on their own doc.
    // The active campaign must always be one of the resulting turned-on campaigns, or null.
    match /users/{uid} {
      // Your own profile stays readable even when switched off, so the app sees `status` and signs out.
      allow read: if (request.auth != null && request.auth.uid == uid)
        || (signedIn() && (isOwner() || resource.data.get('managerId', null) == request.auth.uid));
      allow update: if signedIn() && (
        (request.auth.uid == uid && changedKeys().hasOnly(['activeCampaignId', 'activeCampaignChangedBy', 'activeCampaignChangedAt'])
          && campaignsValid() && markerValid())
        // The rep dismissing the "You're on X today" banner.
        || (request.auth.uid == uid && changedKeys().hasOnly(['campaignNoticeAckAt'])
          && request.resource.data.campaignNoticeAckAt is number)
        || (resource.data.get('managerId', null) == request.auth.uid
          && changedKeys().hasOnly(['campaignIds', 'activeCampaignId', 'activeCampaignChangedBy', 'activeCampaignChangedAt'])
          && campaignsValid() && markerValid())
        || (isOwner() && changedKeys().hasOnly(['campaignIds', 'activeCampaignId', 'activeCampaignChangedBy', 'activeCampaignChangedAt', 'ringColor', 'farBlockExempt'])
          && (!changedKeys().hasAny(['ringColor']) || request.resource.data.ringColor is string)
          && (!changedKeys().hasAny(['farBlockExempt'])
            || (request.auth.uid != uid && request.resource.data.get('farBlockExempt', false) is bool))
          && (!changedKeys().hasAny(['campaignIds', 'activeCampaignId']) || campaignsValid())
          && markerValid()));

      // The written doc's campaignIds is a list and its activeCampaignId is in it (or null).
      function campaignsValid() {
        return request.resource.data.get('campaignIds', []) is list
          && (request.resource.data.get('activeCampaignId', null) == null
            || request.resource.data.get('activeCampaignId', null) in request.resource.data.get('campaignIds', []));
      }

      // Changing the active campaign stamps who did it (the writer) and when; the stamp only moves
      // with a real change. It drives the rep's banner (the portal writes it via the admin SDK).
      function markerValid() {
        return changedKeys().hasAny(['activeCampaignId'])
          ? request.resource.data.get('activeCampaignChangedBy', null) == request.auth.uid
            && request.resource.data.get('activeCampaignChangedAt', null) is number
          : !changedKeys().hasAny(['activeCampaignChangedBy', 'activeCampaignChangedAt']);
      }
    }

    // Campaigns and their buttons (dispositions): everyone signed in reads; owners create and edit
    // them (campaign editor, CAMPAIGN_EDITOR_SPEC.md). Never deleted from the app: houses and knocks
    // reference campaign and disposition ids (the portal's admin SDK bypasses these rules).
    match /campaigns/{campaignId} {
      allow read: if signedIn();
      allow create: if canEditCampaigns()
        && request.resource.data.keys().hasOnly(['name', 'type', 'dispositions', 'carrier', 'quickPicks', 'access', 'updatedAt', 'updatedBy'])
        && campaignValid();
      // Fields from elsewhere (the portal) may stay on the doc; the app changes only these.
      // Soft delete (archive) is a client update: the app's Delete button stamps
      // archived/archivedAt/archivedBy. See archiveValid(): archiving is one-way from a client;
      // restoring is Admin SDK/portal only. Hard delete stays denied.
      allow update: if canEditCampaigns()
        && changedKeys().hasOnly(['name', 'type', 'dispositions', 'carrier', 'quickPicks', 'access', 'updatedAt', 'updatedBy',
                                  'archived', 'archivedAt', 'archivedBy'])
        && campaignValid()
        && archiveValid();
      allow delete: if false;

      // Who may create and edit campaigns: owners (Jacob 2026-10-13). To let managers in later,
      // widen this and canEditCampaigns() in src/lib/campaignEditor.ts together.
      function canEditCampaigns() {
        return isOwner();
      }

      // The written doc's basic shape (the app checks each disposition; rules cannot loop over a
      // list): a 1-40 character name, a known type, 1-60 dispositions, a carrier (1-40) on fiber,
      // at most 10 quick picks, access 'locked' or 'open' (missing = locked), and the writer's stamp.
      function campaignValid() {
        let d = request.resource.data;
        return d.get('name', null) is string && d.name.size() > 0 && d.name.size() <= 40
          && d.get('type', null) in ['fiber', 'solar', 'alarm', 'other']
          && d.get('dispositions', null) is list && d.dispositions.size() > 0 && d.dispositions.size() <= 60
          && (!('carrier' in d) || (d.carrier is string && d.carrier.size() > 0 && d.carrier.size() <= 40))
          && (d.type != 'fiber' || 'carrier' in d)
          && (!('quickPicks' in d) || (d.quickPicks is list && d.quickPicks.size() <= 10))
          && (!('access' in d) || d.access in ['locked', 'open'])
          && d.get('updatedBy', null) == request.auth.uid
          && d.get('updatedAt', null) is number;
      }

      // Archive stamp, judged on what the write changes (not the whole doc, so an archived
      // campaign stays editable by any owner and an Admin SDK restore never blocks later edits).
      // Not archived: the stamp may only change by archiving (archived == true, a number
      // archivedAt, archivedBy == the writer). Archived: archived/archivedAt/archivedBy are
      // frozen; changing or deleting any of them (un-archive) is denied.
      function archiveValid() {
        let stamp = ['archived', 'archivedAt', 'archivedBy'];
        let d = request.resource.data;
        return resource.data.get('archived', false) == true
          ? !changedKeys().hasAny(stamp)
          : (!changedKeys().hasAny(stamp)
            || (d.get('archived', null) == true
              && d.get('archivedAt', null) is number
              && d.get('archivedBy', null) == request.auth.uid));
      }
    }

    // One door (or apartment building). Owners load and assign packs.
    // A rep sees only doors assigned to them; a manager also sees their team's doors. In an open
    // campaign turned on for them, both also see its unassigned doors (openToMe).
    match /houses/{houseId} {
      allow read: if isOwner()
        || (signedIn() && resource.data.assignedRepId == request.auth.uid)
        || (signedIn() && resource.data.managerId == request.auth.uid)
        || openToMe(resource.data);

      // A rep can drop a house that is missing from the pack: it is theirs, marked as
      // rep-created, carries their manager, and is in a campaign turned on for them (the one they
      // were working when they added it: a door added offline still saves after their active
      // campaign changed, M21 bug hunt 2026-10-18). Only the
      // fields the app writes for a new door (addHouse), with the right types, and nothing on it
      // yet: no mark, units, note, contact or imported result (#39).
      allow create: if isOwner()
        || (signedIn()
          && request.resource.data.keys().hasOnly(['campaignId', 'packId', 'packName', 'address', 'city', 'lat',
                                                   'lng', 'assignedRepId', 'managerId', 'last', 'notHomeCount',
                                                   'unitOrder', 'units', 'movedBy', 'createdBy', 'updatedAt',
                                                   'addressPending'])
          && request.resource.data.assignedRepId == request.auth.uid
          && request.resource.data.createdBy == request.auth.uid
          && request.resource.data.get('managerId', null) == me().get('managerId', null)
          && (request.resource.data.campaignId == me().get('activeCampaignId', null)
            || request.resource.data.campaignId in me().get('campaignIds', []))
          && repAddedValid());

      // A rep-added door's shape: text fields of sane length, a real position, a blank state.
      function repAddedValid() {
        let d = request.resource.data;
        return d.get('packId', '') is string && d.get('packId', '').size() <= 200
          && d.get('packName', '') is string && d.get('packName', '').size() <= 200
          && d.get('address', '') is string && d.get('address', '').size() <= 200
          && d.get('city', '') is string && d.get('city', '').size() <= 100
          && latLngValid(d)
          && d.get('last', null) == null && d.get('notHomeCount', 0) == 0
          && d.get('unitOrder', null) == null && d.get('units', null) == null
          && d.get('movedBy', null) == null
          && d.get('addressPending', true) == true
          && timeValid(d.get('updatedAt', 0));
      }

      function latLngValid(d) {
        return d.get('lat', null) is number && d.lat >= -90 && d.lat <= 90
          && d.get('lng', null) is number && d.lng >= -180 && d.lng <= 180;
      }

      // `updatedAt` on an app write: the server's clock (serverTimestamp, #39.5e), never a time the
      // phone picks, so a tampered client can't date doors ahead and crowd big campaigns' change
      // listens (L4 bug hunt 2026-10-18). Owners, the portal and imports may still write a number.
      // For now a number at most 1 h past the server's clock is still taken too: builds older than
      // 6d3564f send the phone's time, and they'd lose every door write the day these rules ship.
      // Once those builds are gone, drop the second half (rules-bug-hunt-check covers both).
      function timeValid(t) {
        return t == request.time
          || (t is number && t <= request.time.toMillis() + 60 * 60 * 1000);
      }

      // Imported doors without a street address (`addressPending`) get one from the first phone
      // that opens them: anyone who can see the door may then fill address/city and clear
      // addressPending (also alongside a mark, in the same batch). Never once it has an address.
      // The assigned rep can record marks and drag the pin, but cannot reassign the
      // house or move it to another campaign (those keys are not in the list).
      // A manager's lasso (Ownership / Status) on their team's doors or their own: the door
      // must end up with them or someone on their team, with that person's manager as
      // managerId (so it stays in some manager's view). The same write sets up or adds units on a
      // team door (`unitOrder`, M15 bug hunt 2026-10-18), as the rep may on their own.
      // Door notes (doorNote / unitNotes, LOGIC_REQUESTS #18): the door's rep and its manager may
      // set or clear them, alone or alongside any of the writes above (see noteKeys()).
      // The No Soliciting sign (noSoliciting, src/lib/noSoliciting.ts) the same way (signKeys()),
      // and an open campaign's unassigned door may get it ticked by anyone who could knock it.
      // A manager may also mark their team's doors (#39, Jacob 2026-10-17): the mark's door write is
      // the lasso one below (the door stays with the rep); the knock is the manager's own.
      // Every app write keeps the door fields' types (doorTypesValid, #39), so a bad value can't
      // crash the map for the rep, their manager and the owners.
      allow update: if isOwner()
        || (doorTypesValid() && (
          (signedIn()
            && resource.data.assignedRepId == request.auth.uid
            && changedKeys().hasOnly(['last', 'notHomeCount', 'units', 'unitOrder',
                                      'lat', 'lng', 'movedBy', 'updatedAt'].concat(addressFillKeys()).concat(noteKeys()).concat(signKeys())
                                      .concat(importedKeepKeys())))
          || (signedIn()
            && (resource.data.get('managerId', null) == request.auth.uid
              || resource.data.assignedRepId == request.auth.uid)
            && changedKeys().hasOnly(['updatedAt'].concat(addressFillKeys()).concat(noteKeys()).concat(signKeys())))
          || (signedIn()
            && (resource.data.get('managerId', null) == request.auth.uid
              || resource.data.assignedRepId == request.auth.uid)
            && changedKeys().hasOnly(['assignedRepId', 'managerId', 'last', 'notHomeCount',
                                      'units', 'unitOrder', 'updatedAt'].concat(addressFillKeys()).concat(noteKeys()).concat(signKeys())
                                      .concat(importedKeepKeys()))
            && request.resource.data.assignedRepId is string
            && (request.resource.data.assignedRepId == request.auth.uid
              || managerOf(request.resource.data.assignedRepId) == request.auth.uid)
            && request.resource.data.get('managerId', null)
              == managerOf(request.resource.data.assignedRepId))
          // Delete door (3c-knock docs/design/DELETE_DOORS.md): a manager parks a door of their
          // team (or their own) out of its campaign, or Undo puts it back. Nothing else changes.
          || (signedIn()
            && isManagerRole()
            && (resource.data.get('managerId', null) == request.auth.uid
              || resource.data.assignedRepId == request.auth.uid)
            && changedKeys().hasOnly(['campaignId', 'deleted', 'updatedAt'])
            && (doorDeleteValid() || doorRestoreValid()))
          // An open campaign's unassigned door (openToMe): fill its address, set up its units while
          // it has none (starting empty: no unit results without a knock, #39), add units after the
          // ones it has (Add units: the list only grows at its end, M15 bug hunt 2026-10-18), or
          // knock it. A knock (a change to `last` or `units`) claims it: the door becomes the
          // writer's, with their manager as on their profile, like an assignment.
          || (openToMe(resource.data)
            && (changedKeys().hasOnly(['updatedAt'].concat(addressFillKeys()))
              || (changedKeys().hasOnly(['updatedAt'].concat(signKeys()))
                && request.resource.data.get('noSoliciting', null) != null)
              || (resource.data.get('unitOrder', null) == null
                && changedKeys().hasOnly(['unitOrder', 'units', 'updatedAt'])
                && request.resource.data.get('unitOrder', null) is list
                && request.resource.data.unitOrder.size() > 0
                && request.resource.data.get('units', null) == {})
              || (resource.data.get('unitOrder', null) is list
                && changedKeys().hasOnly(['unitOrder', 'updatedAt'])
                && request.resource.data.get('unitOrder', null) is list
                && request.resource.data.unitOrder.size() > resource.data.unitOrder.size()
                && request.resource.data.unitOrder[0:resource.data.unitOrder.size()] == resource.data.unitOrder)
              || (changedKeys().hasOnly(['assignedRepId', 'managerId', 'last', 'notHomeCount',
                                         'units', 'updatedAt'].concat(addressFillKeys()).concat(importedKeepKeys())
                                         .concat(signKeys()))
                && changedKeys().hasAny(['last', 'units'])
                && request.resource.data.assignedRepId == request.auth.uid
                && request.resource.data.get('managerId', null) == me().get('managerId', null))))));

      // The door fields an app write changed have the types the app reads (src/lib/types.ts
      // HouseDoc): a mark is { dispositionId, at, repId, knockId } (+ bulk / imported /
      // appointmentAt), counts are whole numbers, units a map, the unit order a list, the position
      // real, `movedBy` the writer. Rules can't loop, so a unit's own state inside `units` isn't
      // checked (the app repairs bad ones on read, houseFromDoc in marking.ts).
      function doorTypesValid() {
        let d = request.resource.data;
        let k = changedKeys();
        return (!k.hasAny(['last']) || markValid(d.get('last', null)))
          // No app write puts a Sold mark on a solar door (the portal writes it, past these rules).
          && (!k.hasAny(['last']) || d.get('last', null) == null
            || d.last.get('dispositionId', null) != 'sold' || !solarCampaign(resource.data.get('campaignId', '')))
          && (!k.hasAny(['notHomeCount']) || (d.get('notHomeCount', null) is int && d.notHomeCount >= 0))
          && (!k.hasAny(['units']) || d.get('units', null) == null || d.units is map)
          && (!k.hasAny(['unitOrder']) || d.get('unitOrder', null) == null
            || (d.unitOrder is list && d.unitOrder.size() <= 2000))
          && (!k.hasAny(['lat', 'lng']) || latLngValid(d))
          && (!k.hasAny(['movedBy']) || d.get('movedBy', null) == request.auth.uid)
          && (!k.hasAny(['updatedAt']) || timeValid(d.get('updatedAt', null)));
      }

      function markValid(m) {
        return m == null
          || (m is map && m.keys().hasOnly(['dispositionId', 'at', 'repId', 'knockId', 'bulk', 'imported', 'appointmentAt'])
            && m.get('dispositionId', null) is string && m.get('at', null) is number
            && m.get('repId', null) is string && m.get('knockId', null) is string);
      }

      // LOGIC_REQUESTS #35: the first real mark on an imported door keeps the lead file's result in
      // `importedMark`. It must be exactly the stored imported mark and its Not Home count, so it
      // can't be made up. (Units keep theirs inside `units`, which the rep may already write.)
      function importedKeepKeys() {
        return changedKeys().hasAny(['importedMark'])
            && resource.data.get('last', null) != null
            && resource.data.last.get('imported', false) == true
            && request.resource.data.importedMark.mark == resource.data.last
            && request.resource.data.importedMark.notHomeCount == resource.data.notHomeCount
          ? ['importedMark']
          : [];
      }

      // Keys an address fill may change: only while the stored door is addressPending, and the
      // result must be a real address with addressPending cleared. Same length caps as a rep-added
      // door (repAddedValid), so one fill can't load ~1 MB onto every viewer's map.
      function addressFillKeys() {
        return resource.data.get('addressPending', false) == true
            && request.resource.data.get('address', '') is string
            && request.resource.data.get('address', '') != ''
            && request.resource.data.get('address', '').size() <= 200
            && request.resource.data.get('city', '') is string
            && request.resource.data.get('city', '').size() <= 100
            && request.resource.data.get('addressPending', false) == false
          ? ['address', 'city', 'addressPending']
          : [];
      }

      // Keys a door-note write may change: only when it is valid. Every note change also writes
      // `noteEdit` = { unit (null = the house note), by: the writer, at }, which names the one
      // note it touches (rules can't loop over a map), and that note must match its stamp.
      function noteKeys() {
        return changedKeys().hasAny(['doorNote', 'unitNotes', 'noteEdit']) && noteWriteValid()
          ? ['doorNote', 'unitNotes', 'noteEdit']
          : [];
      }

      function noteWriteValid() {
        let e = request.resource.data.get('noteEdit', null);
        return e is map && e.keys().hasOnly(['unit', 'by', 'at'])
          && e.get('by', null) == request.auth.uid
          && e.get('at', null) is number
          && (e.get('unit', null) == null
            ? !changedKeys().hasAny(['unitNotes']) && noteShape(request.resource.data.get('doorNote', null), e)
            : unitNoteValid(e));
      }

      // A unit note: the unit is one of the building's, and it is the only unit note changed.
      function unitNoteValid(e) {
        let after = request.resource.data.get('unitNotes', {});
        return e.unit is string
          && !changedKeys().hasAny(['doorNote'])
          && request.resource.data.get('unitOrder', null) is list
          && e.unit in request.resource.data.unitOrder
          && after is map
          && after.diff(resource.data.get('unitNotes', {})).affectedKeys().hasOnly([e.unit])
          && noteShape(after.get(e.unit, null), e);
      }

      // Cleared (null), or { text: 1-1000 characters, by, at } matching the stamp.
      function noteShape(n, e) {
        return n == null
          || (n is map && n.keys().hasOnly(['text', 'by', 'at'])
            && n.get('text', null) is string && n.text.size() > 0 && n.text.size() <= 1000
            && n.get('by', null) == e.by && n.get('at', null) == e.at);
      }

      // Keys a No Soliciting sign write may change: only when it is valid. Ticking writes
      // { by: the writer, at } on a door without one; clearing deletes it, by whoever ticked it or
      // the door's manager (owners write anything above).
      function signKeys() {
        return changedKeys().hasAny(['noSoliciting']) && signWriteValid() ? ['noSoliciting'] : [];
      }

      function signWriteValid() {
        let n = request.resource.data.get('noSoliciting', null);
        let was = resource.data.get('noSoliciting', null);
        return n == null
          ? was != null && (was.get('by', null) == request.auth.uid
            || resource.data.get('managerId', null) == request.auth.uid)
          : was == null && n is map && n.keys().hasOnly(['by', 'at'])
            && n.get('by', null) == request.auth.uid && n.get('at', null) is number;
      }

      // Delete: a live door goes to '_deleted', stamped with the writer, a time and the campaign it was in.
      function doorDeleteValid() {
        let d = request.resource.data.get('deleted', null);
        return resource.data.campaignId != '_deleted'
          && resource.data.get('deleted', null) == null
          && request.resource.data.campaignId == '_deleted'
          && d is map && d.keys().hasOnly(['by', 'at', 'campaignId'])
          && d.get('by', null) == request.auth.uid
          && d.get('at', null) is number
          && d.get('campaignId', null) == resource.data.campaignId;
      }

      // Undo: a deleted door goes back to the campaign its stamp names, and the stamp goes.
      function doorRestoreValid() {
        return resource.data.campaignId == '_deleted'
          && resource.data.get('deleted', null) is map
          && !('deleted' in request.resource.data)
          && request.resource.data.campaignId == resource.data.deleted.campaignId;
      }

      // Mirrors appRoleFor's manager check (src/lib/roles.ts MANAGEMENT_FIELD_ROLES); the copy in
      // `match /shoutouts` is scoped to that block.
      function isManagerRole() {
        return me().get('role', '') == 'operations'
          || me().get('fieldRole', '') in ['l1_manager', 'l2_manager', 'ibo_level_1', 'ibo_level_2', 'ibo_level_3',
                                           'ibo_level_4', 'general_manager', 'office_manager', 'regional_manager',
                                           'director'];
      }

      allow delete: if isOwner();
    }

    // Append-only log of every mark. A rep logs knocks only on their own doors and an open
    // campaign's unassigned doors (openToMe); owners on any door; managers also on their team's
    // doors (#39, Jacob 2026-10-17: the visit is the manager's own, `repId` = them, while the door
    // stays the rep's; lasso Status changes, `bulk`, too). Everyone can take back their own (Undo),
    // and nobody edits a knock after the fact. Each knock carries the knocker's manager
    // (`managerId`, as on their users doc at the time), so a manager reads their team's knocks
    // without a per-knock profile lookup.
    match /knocks/{knockId} {
      allow read: if isOwner()
        || (signedIn() && resource.data.repId == request.auth.uid)
        || (signedIn() && resource.data.get('managerId', null) == request.auth.uid);

      allow create: if signedIn()
        && knockShape()
        && request.resource.data.repId == request.auth.uid
        // The knocker is the writer, so their manager is on the profile the rules already read.
        && request.resource.data.get('managerId', null) == me().get('managerId', null)
        // FAR_KNOCK_SPEC: a knock with a verified location (far == false) must be within
        // FAR_METERS (150 m) of the door. Rules can't check GPS, so this only stops casual tampering;
        // the app refuses far marks itself. Bulk Status knocks carry no distance.
        && (request.resource.data.get('far', false) == true
          || !(request.resource.data.get('distanceM', null) is number)
          || request.resource.data.distanceM <= 150)
        && knockTimeValid()
        && replacesValid()
        // A solar door's Sold is the portal's, from the consultation (admin SDK, past these rules):
        // no app knock may be Sold there (solarDispositions.ts mayMark), older builds included.
        && !(request.resource.data.get('dispositionId', null) == 'sold'
          && solarCampaign(request.resource.data.get('campaignId', '')))
        && (isOwner()
          || (door().campaignId == request.resource.data.campaignId
            && (door().assignedRepId == request.auth.uid
              || door().get('managerId', null) == request.auth.uid
              // An open campaign's unassigned door, as it was before this write (the same batch
              // claims it; OPEN_CAMPAIGNS_SPEC.md). Not lasso Status knocks.
              || (request.resource.data.get('bulk', false) != true && openToMe(door())))));

      // Undo of a knock that isn't on the server (yet): `resource` is the doc as it was before the
      // batch, so an offline mark + Undo sent in one batch deletes a doc that doesn't exist. That
      // removes nothing, so it is allowed (like shoutouts). Undo is right after the mark, so a knock
      // on the server may be taken back only while it is as young as a new knock may be
      // (knockMaxAgeMs, the same window knockTimeValid takes): an Undo queued with its mark still
      // syncs, even one write at a time, but nobody wipes older stats. Keep both on knockMaxAgeMs:
      // a shorter delete window would refuse the Undo of an old offline mark the create took.
      allow delete: if signedIn() && (resource == null
        || (resource.data.repId == request.auth.uid
          && resource.data.createdAt >= request.time.toMillis() - knockMaxAgeMs()));
      allow update: if false;

      // The knock's door as it was before this write (one read, however often it is used).
      function door() {
        return get(/databases/$(database)/documents/houses/$(request.resource.data.houseId)).data;
      }

      // Known fields only (KnockDoc in src/lib/types.ts), each with its type; a note of at most
      // 2000 characters (KNOCK_NOTE_MAX). The result must be an id, but rules can't loop over the
      // campaign's dispositions to check it is one of them (the app shows an unknown one grey).
      function knockShape() {
        let d = request.resource.data;
        return d.keys().hasOnly(['houseId', 'unit', 'campaignId', 'repId', 'managerId', 'dispositionId', 'note',
                                 'appointmentAt', 'createdAt', 'lat', 'lng', 'distanceM', 'far', 'accuracyM', 'gps',
                                 'replacesId', 'bulk'])
          && d.get('houseId', null) is string
          && (d.get('unit', null) == null || (d.unit is string && d.unit.size() <= 100))
          && d.get('campaignId', null) is string
          && d.get('dispositionId', null) is string && d.dispositionId.size() > 0 && d.dispositionId.size() <= 100
          && (d.get('note', null) == null || (d.note is string && d.note.size() <= 2000))
          && (d.get('appointmentAt', null) == null || d.appointmentAt is number)
          && d.get('createdAt', null) is number
          && (d.get('lat', null) == null || d.lat is number)
          && (d.get('lng', null) == null || d.lng is number)
          && (d.get('distanceM', null) == null || d.distanceM is number)
          && d.get('far', false) is bool
          && (d.get('accuracyM', null) == null || d.accuracyM is number)
          && (d.get('gps', null) == null || d.gps in ['good', 'weak', 'none'])
          && (d.get('replacesId', null) == null || d.replacesId is string)
          && d.get('bulk', true) == true;
      }

      // Made at most knockMaxAgeMs ago and not more than 1 h ahead of the server's clock (phones'
      // clocks drift): no back- or forward-dated stats.
      function knockTimeValid() {
        let t = request.resource.data.createdAt;
        let now = request.time.toMillis();
        return t >= now - knockMaxAgeMs() && t <= now + 60 * 60 * 1000;
      }

      // How old a knock may be when it reaches the server, for both a new knock (knockTimeValid)
      // and its Undo (allow delete): 30 days, as on prototype-v1 (eeee124, bug hunt 2026-10-18).
      // A rep offline for days, or marks parked for another user on this phone (PARKED_MAX_AGE_MS
      // in src/lib/db.ts), must still sync, not be refused and rolled back. Rules can't see when
      // the phone queued a write, only the knock's time.
      function knockMaxAgeMs() {
        return 30 * 24 * 60 * 60 * 1000;
      }

      // A re-mark replaces only the writer's own knock on the same door (house and unit), as it is
      // after this batch (it may be written in the same one). One that doesn't exist hides nothing.
      function replacesValid() {
        let id = request.resource.data.get('replacesId', null);
        return id == null || replacedOk(getAfter(/databases/$(database)/documents/knocks/$(id)));
      }

      function replacedOk(r) {
        return r == null
          || (r.data.repId == request.auth.uid
            && r.data.houseId == request.resource.data.houseId
            && r.data.get('unit', null) == request.resource.data.get('unit', null));
      }
    }

    // Competitions (LOGIC_REQUESTS #25, docs/COMPETITIONS_FEED_SPEC.md): everyone signed in reads;
    // owners create, edit and end them (ending = status 'ended' with `endedAt`). Never deleted from
    // the app. Shapes: CompetitionDoc in src/lib/types.ts (checked in full by src/lib/competitions.ts).
    match /competitions/{competitionId} {
      allow read: if signedIn();
      allow create: if isOwner()
        && request.resource.data.keys().hasOnly(['name', 'startAt', 'endAt', 'campaignIds', 'metric', 'points',
                                                 'mode', 'prize', 'status', 'endedAt', 'createdBy', 'createdAt',
                                                 'updatedBy', 'updatedAt'])
        && request.resource.data.get('status', null) == 'active'
        && request.resource.data.get('createdBy', null) == request.auth.uid
        && request.resource.data.get('createdAt', null) is number
        && competitionValid();
      allow update: if isOwner()
        && changedKeys().hasOnly(['name', 'startAt', 'endAt', 'campaignIds', 'metric', 'points', 'mode', 'prize',
                                  'status', 'endedAt', 'updatedBy', 'updatedAt'])
        // Every edit re-stamps (a new `updatedAt`).
        && changedKeys().hasAny(['updatedAt'])
        && competitionValid();
      allow delete: if false;

      // A 1-60 character name, end after start, 1-30 campaigns, a known metric and mode, a points
      // table exactly when the metric is points, a prize of at most 200 characters (or none),
      // `endedAt` set exactly when ended, and the writer's stamp.
      function competitionValid() {
        let d = request.resource.data;
        return d.get('name', null) is string && d.name.size() > 0 && d.name.size() <= 60
          && d.get('startAt', null) is number && d.get('endAt', null) is number && d.endAt > d.startAt
          && d.get('campaignIds', null) is list && d.campaignIds.size() > 0 && d.campaignIds.size() <= 30
          && d.get('metric', null) in ['doors', 'talked', 'sold', 'appointments', 'points']
          && (d.metric == 'points' ? pointsValid(d.get('points', null)) : d.get('points', null) == null)
          && d.get('mode', null) in ['rep', 'team']
          && (d.get('prize', null) == null || (d.prize is string && d.prize.size() <= 200))
          && (d.get('status', null) == 'active'
            ? d.get('endedAt', null) == null
            : d.get('status', null) == 'ended' && d.get('endedAt', null) is number)
          && d.get('updatedBy', null) == request.auth.uid
          && d.get('updatedAt', null) is number;
      }

      function pointsValid(p) {
        return p is map && p.keys().hasOnly(['door', 'talked', 'appointment', 'sale'])
          && p.get('door', null) is number && p.get('talked', null) is number
          && p.get('appointment', null) is number && p.get('sale', null) is number;
      }
    }

    // Team feed (LOGIC_REQUESTS #26). `managerId` is the team a shoutout goes to (a manager's uid;
    // null = people with no manager); `toAll` is an owner's note to everyone. A user reads their
    // own team's (managerId = their manager), the team they lead (managerId = them) and toAll ones;
    // owners read all. Writes:
    //   - sale / badge: about the writer, named as on their profile, to their manager's team or the
    //     team they lead. A sale's id is a knock of the writer's (written before or in the same
    //     batch), and its street never starts with a house number ("123", "123A", "123-A",
    //     "123½", "12-14"; `streetOnly` in src/lib/shoutouts.ts sends null for those). A badge's
    //     text is its label.
    //   - `at` (the feed's order) is at most an hour past the server's clock, so a tampered phone
    //     can't pin a shoutout to the top of the feed (L5 bug hunt 2026-10-18).
    //   - manual: owners to any team or everyone; managers (portal management role) to their team.
    // Nobody edits one. The writer takes theirs back (Undo of a Sold), owners remove any, and
    // deleting one that is not there (never reached the server) is allowed.
    match /shoutouts/{shoutoutId} {
      allow read: if isOwner()
        || (signedIn() && (resource.data.toAll == true
          || resource.data.managerId == request.auth.uid
          || resource.data.managerId == me().get('managerId', null)));

      allow create: if signedIn() && shoutoutShape()
        && request.resource.data.repId == request.auth.uid
        && request.resource.data.repName == me().get('displayName', '')
        && (
          (request.resource.data.kind == 'sale'
            && request.resource.data.toAll == false && toMyTeam()
            && request.resource.data.campaignId is string
            && request.resource.data.text == null && request.resource.data.badgeId == null
            && getAfter(/databases/$(database)/documents/knocks/$(shoutoutId)).data.repId == request.auth.uid)
          || (request.resource.data.kind == 'badge'
            && request.resource.data.toAll == false && toMyTeam()
            && request.resource.data.street == null
            && request.resource.data.text is string && request.resource.data.badgeId is string
            && badgeTextValid(request.resource.data))
          || (request.resource.data.kind == 'manual'
            && request.resource.data.street == null && request.resource.data.badgeId == null
            && request.resource.data.text is string
            && (isOwner()
              || (isManagerRole() && request.resource.data.managerId == request.auth.uid
                && request.resource.data.toAll == false))));

      allow update: if false;
      allow delete: if signedIn() && (resource == null || resource.data.repId == request.auth.uid || isOwner());

      // Every field present (reads and queries rely on them), with the right types and sizes.
      function shoutoutShape() {
        let d = request.resource.data;
        let fields = ['kind', 'repId', 'repName', 'managerId', 'toAll', 'campaignId', 'street', 'text', 'badgeId', 'at'];
        return d.keys().hasOnly(fields) && d.keys().hasAll(fields)
          && d.kind in ['sale', 'badge', 'manual']
          && d.repName is string && d.repName.size() <= 100
          && (d.managerId == null || d.managerId is string)
          && d.toAll is bool
          && (d.campaignId == null || d.campaignId is string)
          && (d.street == null || (d.street is string && d.street.size() > 0 && d.street.size() <= 100
            && !d.street.matches('[0-9]+(-?[A-Za-z]|[½¼¾⅓⅔])?([-/][0-9]+[A-Za-z]?)? .*')))
          && (d.text == null || (d.text is string && d.text.size() > 0 && d.text.size() <= 280))
          && (d.badgeId == null || (d.badgeId is string && d.badgeId.size() <= 60))
          && d.at is number && d.at <= request.time.toMillis() + 60 * 60 * 1000;
      }

      // A badge's text is its label in BADGE_CATALOG (src/lib/leaderboard.ts; shoutouts.test.ts
      // keeps the two in step), or "Best day: N doors", so a badge can't carry any message (L5).
      function badgeTextValid(d) {
        let labels = {
          'first-sale': 'First sale', 'sales-10': '10 sales', 'sales-50': '50 sales', 'sales-100': '100 sales',
          'doors-100': '100 doors', 'doors-500': '500 doors', 'doors-1000': '1,000 doors',
          'streak-5': '5-day streak', 'streak-10': '10-day streak'
        };
        return (d.badgeId in labels && d.text == labels[d.badgeId])
          || (d.badgeId == 'best-day' && d.text.matches('Best day: [0-9][0-9,]{0,12} doors'));
      }

      // The writer's manager's team, or the team they lead.
      function toMyTeam() {
        return request.resource.data.managerId == me().get('managerId', null)
          || request.resource.data.managerId == request.auth.uid;
      }

      // Mirrors appRoleFor's manager check (src/lib/roles.ts MANAGEMENT_FIELD_ROLES).
      function isManagerRole() {
        return me().get('role', '') == 'operations'
          || me().get('fieldRole', '') in ['l1_manager', 'l2_manager', 'ibo_level_1', 'ibo_level_2', 'ibo_level_3',
                                           'ibo_level_4', 'general_manager', 'office_manager', 'regional_manager',
                                           'director'];
      }
    }

    // "Booked nearby" / "Went solar" pins (3c-knock docs/design/NEARBY_LEADS.md option B,
    // src/lib/proofPins.ts there). One doc per door, id = the house id, holding only what the pin needs:
    //   { campaignId, cell (geohash-5), lat, lng (3 decimals), kind: 'booked' | 'solar', at (ms) }
    // Positions are approximate on purpose (owner, 2026-10-22): a ~110 m grid, never the exact house.
    // No name, phone, address, note or rep. Query this allows:
    //   anyone on the campaign: proofPins where campaignId == X and cell in [<= 30 cells]
    // Readers (Jacob 2026-10-22): reps on the campaign, their managers and owners. "Holds at least
    // one door in it" and "within ~5 km of those doors" are enforced in the app; a pin shows only its
    // status and age. The portal (admin SDK, past these rules; src/lib/solar/proofPins.ts) sets
    // kind 'solar' on Sold and deletes the pin on No-Show / Cancelled. Clients may only ever write
    // a 'booked' pin that matches their own Appointment Booked mark on the door, and delete a
    // 'booked' pin once the door is no longer booked; 'solar' pins are server-only.
    match /proofPins/{houseId} {
      // Signed in with the campaign turned on for them (owners / admins: every campaign).
      allow read: if signedIn()
        && (isOwner() || resource.data.campaignId in me().get('campaignIds', []));

      // Set in the batched write of an Appointment Booked mark: only by the user whose own (not
      // imported) mark the door holds once that batch lands, with that mark's time, at the door's
      // position (rounded to 3 decimals), in the door's campaign, and only the pin's own fields.
      // A 'solar' pin stays the portal's.
      allow create, update: if signedIn()
        && (resource == null || resource.data.kind == 'booked')
        && proofPinShape()
        && request.resource.data.kind == 'booked'
        && bookedByMeAfter(houseId);

      // A booked door re-marked (or its booking undone): its pin goes in the same batch, once the
      // door no longer carries an Appointment Booked mark (or is gone). A 'solar' pin is never
      // client-deleted (the portal owns it). Deleting a pin that is not there is allowed.
      allow delete: if signedIn()
        && (resource == null || (resource.data.kind == 'booked' && !doorBookedAfter(houseId)));

      // Exactly the six fields, with their types and ranges; positions are on the 3-decimal (~110 m) grid.
      function proofPinShape() {
        let d = request.resource.data;
        let fields = ['campaignId', 'cell', 'lat', 'lng', 'kind', 'at'];
        return d.keys().hasOnly(fields) && d.keys().hasAll(fields)
          && d.campaignId is string && d.campaignId.size() > 0 && d.campaignId.size() <= 200
          && d.cell is string && d.cell.matches('[0-9b-hjkmnp-z]{5}')
          && d.lat is number && d.lat >= -90 && d.lat <= 90
          && d.lng is number && d.lng >= -180 && d.lng <= 180
          && math.round(d.lat * 1000) / 1000.0 == d.lat
          && math.round(d.lng * 1000) / 1000.0 == d.lng
          && d.kind in ['booked', 'solar']
          && d.at is number && d.at > 0 && d.at <= request.time.toMillis() + 60 * 60 * 1000;
      }

      // The door as the batch leaves it. Call it only after existsAfter (doorExistsAfter): a get
      // of a missing doc errors, which would refuse the write instead of answering false.
      function doorAfter(id) {
        return getAfter(/databases/$(database)/documents/houses/$(id));
      }

      function doorExistsAfter(id) {
        return existsAfter(/databases/$(database)/documents/houses/$(id));
      }

      // A houses doc's mark is a real (not imported) Appointment Booked.
      function markBooked(door) {
        return door.data.get('last', null) is map
          && door.data.last.get('dispositionId', '') == 'appointment_set'
          && door.data.last.get('imported', false) != true;
      }

      // The door, as the batch leaves it, exists, is not soft-deleted (campaignId '_deleted',
      // 3c-knock docs/design/DELETE_DOORS.md) and carries an Appointment Booked mark. So a
      // delete batch may drop the door's booked pin, and no pin can be made for a deleted door.
      function doorBookedAfter(id) {
        return doorExistsAfter(id)
          && doorAfter(id).data.get('campaignId', '') != '_deleted'
          && markBooked(doorAfter(id));
      }

      // The door's own mark after the batch is the caller's Appointment Booked (not a lead-file
      // import), in the pin's campaign, at the pin's time, on the grid point nearest the door:
      // a 3-decimal value within 0.0006 of its position (the rounded value is at most 0.0005
      // away; rules cannot reproduce JS rounding of exact halves on negative longitudes, so the
      // tolerance stands in for exact equality).
      function bookedByMeAfter(id) {
        return doorBookedAfter(id) && myPinFor(doorAfter(id), request.resource.data);
      }

      function myPinFor(door, d) {
        return door.data.last.get('repId', '') == request.auth.uid
          && door.data.get('campaignId', '') == d.campaignId
          && door.data.last.get('at', null) == d.at
          && math.abs(d.lat - door.data.lat) <= 0.0006
          && math.abs(d.lng - door.data.lng) <= 0.0006;
      }
    }
  }
}
