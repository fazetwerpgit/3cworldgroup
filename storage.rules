rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    function caller() {
      return firestore.get(/databases/(default)/documents/users/$(request.auth.uid)).data;
    }
    // Platform management: owner/admin/operations.
    function isPlatformManagement() {
      return request.auth != null && caller().get('role', null) in ['owner', 'admin', 'operations'];
    }
    // Every FieldRoles value in src/types/auth.ts (media.test.ts checks the two agree).
    function fieldRoleValues() {
      return ['entry_rep', 'entry_level_rep', 'l1_manager', 'l2_manager',
        'ibo_level_1', 'ibo_level_2', 'ibo_level_3', 'ibo_level_4',
        'general_manager', 'gm_in_training', 'office_manager',
        'ae_tier_1', 'ae_tier_2', 'regional_manager', 'director', 'internal_rep'];
    }
    // resolveRoles (src/types/auth.ts): a valid `fieldRole`, or a legacy field
    // role stored in `role`. Platform and field roles never overlap, so a role
    // that is a field role value is never also a platform role.
    function hasFieldRole(data) {
      return data.get('fieldRole', null) in fieldRoleValues()
        || data.get('role', null) in fieldRoleValues();
    }
    // Mirrors the API status gate: an active account, or a hired rep still in
    // onboarding (pending WITH a field role; /portal/training and chat are on
    // the onboarding allowlist). A role-less pending self-signup or an inactive
    // account gets nothing.
    function canReadTraining() {
      let data = caller();
      return request.auth != null
        && (data.get('status', null) == 'active'
          || (data.get('status', null) == 'pending' && hasFieldRole(data)));
    }

    // University training content: platform management uploads; staff fetch a
    // file by its exact path (getDownloadURL). Only management may list, so
    // nobody else can enumerate drafts.
    match /training/{allPaths=**} {
      allow get: if canReadTraining();
      allow list: if isPlatformManagement();
      allow write: if isPlatformManagement()
        && request.resource.size < 1024 * 1024 * 1024
        && request.resource.contentType.matches('application/pdf|image/.*|video/.*');
    }
    // Team chat files too big for a request body (Vercel caps it near 4.5 MB):
    // the client writes chat-pending/{uid}/{id}.{ext} itself, then POSTs only the
    // path to /api/portal/chat/media, which re-checks the object (owner, size,
    // type, PDF header, channel membership, chat terms, file-name filter) and
    // moves it to chat/{channelId}/ with a download token. Only the owner may
    // create, once (no overwrite), up to 10 MB, with a content type that matches
    // the extension. Nobody reads, lists or deletes here from a client; the
    // route removes the pending object. Same account gate as training.
    match /chat-pending/{uid}/{name} {
      allow create: if canReadTraining()
        && request.auth.uid == uid
        && request.resource.size > 0
        && request.resource.size <= 10 * 1024 * 1024
        && name.matches('[A-Za-z0-9-]{8,64}[.](pdf|png|jpg|webp|gif)')
        && ((name.matches('.*[.]pdf') && request.resource.contentType == 'application/pdf')
          || (name.matches('.*[.]png') && request.resource.contentType == 'image/png')
          || (name.matches('.*[.]jpg') && request.resource.contentType == 'image/jpeg')
          || (name.matches('.*[.]webp') && request.resource.contentType == 'image/webp')
          || (name.matches('.*[.]gif') && request.resource.contentType == 'image/gif'));
      allow read, update, delete: if false;
    }
    // Everything else (onboarding/forms, chat/) is Admin-SDK-only.
    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
